{
  "name": "@loglayer/transport-opentelemetry",
  "description": "OpenTelemetry transport for LogLayer for use with log processors.",
  "version": "4.3.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/loglayer/loglayer.git",
    "directory": "packages/transports/opentelemetry"
  },
  "author": "Theo Gravity <theo@suteki.nu>",
  "keywords": [
    "logging",
    "log",
    "loglayer",
    "opentelemetry",
    "otel",
    "transport"
  ],
  "scripts": {
    "build": "tsdown src/index.ts",
    "test": "vitest --run",
    "clean": "rm -rf .turbo node_modules dist",
    "lint": "biome check --no-errors-on-unmatched --write --unsafe src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "verify-types": "tsc --noEmit",
    "livetest": "tsx --import ./express-example/instrumentation.ts ./express-example/app.ts"
  },
  "dependencies": {
    "@loglayer/transport": "workspace:*",
    "@opentelemetry/api-logs": "0.223.0"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/instrumentation-express": "0.67.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "express": "5.3.0",
    "loglayer": "workspace:*",
    "serialize-error": "13.0.2",
    "tsdown": "0.23.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "bugs": "https://github.com/loglayer/loglayer/issues",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://loglayer.dev",
  "packageManager": "pnpm@10.20.0"
}
