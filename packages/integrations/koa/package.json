{
  "name": "@loglayer/koa",
  "description": "Koa integration for LogLayer with request-scoped logging, auto request logging, and error handling.",
  "version": "1.3.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/loglayer/loglayer.git",
    "directory": "packages/integrations/koa"
  },
  "author": "Theo Gravity <theo@suteki.nu>",
  "keywords": [
    "logging",
    "log",
    "loglayer",
    "koa",
    "integration",
    "middleware"
  ],
  "scripts": {
    "build": "tsdown src/index.ts",
    "test": "vitest --run",
    "livetest": "tsx src/__tests__/livetest.ts",
    "clean": "rm -rf .turbo node_modules dist",
    "lint": "biome check --no-errors-on-unmatched --write --unsafe src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "verify-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@loglayer/transport-simple-pretty-terminal": "workspace:*",
    "@types/koa": "3.0.3",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.0",
    "koa": "3.2.1",
    "loglayer": "workspace:*",
    "serialize-error": "13.0.2",
    "supertest": "7.3.1",
    "tsdown": "0.23.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "koa": ">=2.0.0",
    "loglayer": "*"
  },
  "bugs": "https://github.com/loglayer/loglayer/issues",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://loglayer.dev",
  "packageManager": "pnpm@10.20.0"
}
